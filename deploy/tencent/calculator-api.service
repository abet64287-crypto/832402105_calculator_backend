[Unit]
Description=Calculator JSON API
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/calculator

[Service]
Type=simple
User=calculator
Group=calculator
WorkingDirectory=/opt/calculator-backend
EnvironmentFile=/etc/calculator-api.env
ExecStart=/usr/bin/python3 -m src.main
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/calculator

[Install]
WantedBy=multi-user.target
