# Copy to /etc/calculator-api.env on the server.
# The Pages origin is the hostname only, without the repository path.
CALCULATOR_HOST=127.0.0.1
CALCULATOR_PORT=8000
CALCULATOR_DB_PATH=/var/lib/calculator/calculations.db
CALCULATOR_ALLOWED_ORIGINS=https://abet64287-crypto.github.io
PYTHONDONTWRITEBYTECODE=1
